# =============================================================================
# Hitch — Environment Variables
# Copy to .env (never commit .env) and fill in real values.
# Set the same vars on each Railway service (web / ws / workers) as needed.
# =============================================================================

# -- Database ----------------------------------------------------------------
# Railway Managed PostgreSQL.
DATABASE_URL="postgresql://user:password@localhost:5432/hitch?schema=public"

# -- Redis (BullMQ + pub/sub) ------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -- Clerk (account auth — EU data region) -----------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Svix signing secret for the user-sync webhook (Clerk dashboard → Webhooks).
CLERK_WEBHOOK_SECRET="whsec_..."
# Clerk UI routing (admin-only sign-in; no public sign-up route).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/admin"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/admin"

# -- Guest booking tokens (HMAC) ---------------------------------------------
# Secret used to sign short-lived guest-booking access tokens. Falls back to
# BETTER_AUTH_SECRET if unset (kept only for backward compatibility).
GUEST_TOKEN_SECRET="generate-with-openssl-rand-base64-32"
# Legacy — retained as the GUEST_TOKEN_SECRET fallback only.
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"

# -- Stripe (multi-currency, manual capture) ---------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# -- DigitalOcean Spaces (S3-compatible, Frankfurt region) -------------------
DO_SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
DO_SPACES_REGION="fra1"
DO_SPACES_BUCKET="hitch-dev"
DO_SPACES_KEY=""
DO_SPACES_SECRET=""
DO_SPACES_CDN_URL="https://hitch-dev.fra1.cdn.digitaloceanspaces.com"

# -- Google Maps -------------------------------------------------------------
# Frontend key (restrict by referrer in Google Cloud Console).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
# Backend key for the Directions API road-distance service (restrict by IP).
GOOGLE_MAPS_SERVER_KEY=""
# Vector Map ID for the dispatch map (Advanced Markers require one). Create in
# Cloud Console → Map Management. Leave blank to use Google's DEMO_MAP_ID in dev.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# -- WebSocket ---------------------------------------------------------------
# Public URL the browser connects to. In prod: wss://api.hitch.is/ws
NEXT_PUBLIC_WS_URL="ws://localhost:3001/ws"
# Port the standalone WS/API process (npm run ws) listens on.
# Resolution order in src/server/index.ts: WS_PORT → API_PORT → PORT → 3001.
WS_PORT="3001"
# PORT is also read by `next start` (web process) — defaults to 3000.
PORT="3000"

# -- Exchange Rate API -------------------------------------------------------
# Default provider: exchangerate.host (daily ISK→EUR/USD fetch worker).
EXCHANGE_RATE_API_KEY=""
# Optional endpoint override so the provider can be swapped without code change.
EXCHANGE_RATE_API_URL="https://api.exchangerate.host/live"

# -- Resend (transactional emails: feedback + booking confirmations) ----------
RESEND_API_KEY="re_..."
# Verified sender (domain must be verified in Resend).
FEEDBACK_NOTIFY_FROM="Hitch <noreply@hitch.is>"
# Where business notifications land.
FEEDBACK_NOTIFY_TO="business@hitch.is"
# Sender for booking confirmation emails (defaults to Hitch <noreply@hitch.is>).
BOOKING_NOTIFY_FROM="Hitch <noreply@hitch.is>"

# -- Sentry (error tracking; unset = disabled, all 3 processes) ----------------
SENTRY_DSN=""
# Defaults to NODE_ENV when unset.
SENTRY_ENVIRONMENT="development"

# -- App URLs (for CORS + redirects + SEO) -----------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_PASSENGER_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3000"
# Canonical site URL (Open Graph metadataBase). In prod: https://hitch.is
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -- Seed (dev only) ---------------------------------------------------------
# Email to promote to SUPER_ADMIN. Sign in via Clerk first, then run db:seed.
SEED_ADMIN_EMAIL="admin@hitch.is"
